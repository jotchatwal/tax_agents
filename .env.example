# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/taxpilot_db?retryWrites=true&w=majority
MONGODB_DATABASE=taxpilot_db

# LLM Provider Configuration (e.g. gemini, openai, anthropic, groq)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Embedding Provider Configuration (e.g. voyage, gemini, openai, local)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Security & App Configuration
APP_SECRET_KEY=change-this-in-production-demo-secret-key-32chars
FRONTEND_ORIGIN=http://localhost:8000
